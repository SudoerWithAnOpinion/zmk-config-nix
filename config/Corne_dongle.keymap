#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include "zmk-helpers/helper.h"

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

ZMK_MOD_MORPH(nav_left_home,
    bindings = <&kp LEFT>, <&kp HOME>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

ZMK_MOD_MORPH(nav_up_pgup,
    bindings = <&kp UP>, <&kp PG_UP>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

ZMK_MOD_MORPH(nav_down_pgdn,
    bindings = <&kp DOWN>, <&kp PG_DN>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

ZMK_MOD_MORPH(nav_right_end,
    bindings = <&kp RIGHT>, <&kp END>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

ZMK_MOD_MORPH(bksp_del_mod,
    bindings = <&kp BSPC>, <&kp DEL>;
    mods = <(MOD_LCTL|MOD_RCTL|MOD_LSFT|MOD_RSFT|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
)

ZMK_TAP_DANCE(td_lshift_capsw,
    tapping-term-ms = <200>;
    bindings = <&kp LSHFT>, <&caps_word>;
)

#define ZMK_BT_SEL_DISC_SHIFT(_name, _slot) \
ZMK_MOD_MORPH(_name, \
    bindings = <&bt BT_SEL _slot>, <&bt BT_DISC _slot>; \
    mods = <(MOD_LSFT|MOD_RSFT)>; \
)

ZMK_BT_SEL_DISC_SHIFT(bt_sel_disc_0, 0)
ZMK_BT_SEL_DISC_SHIFT(bt_sel_disc_1, 1)
ZMK_BT_SEL_DISC_SHIFT(bt_sel_disc_2, 2)
ZMK_BT_SEL_DISC_SHIFT(bt_sel_disc_3, 3)
ZMK_BT_SEL_DISC_SHIFT(bt_sel_disc_4, 4)

/ {
        // Activate ADJUST layer by pressing raise and lower
        conditional_layers {
            compatible = "zmk,conditional-layers";
            adjust_layer {
                if-layers = <LOWER RAISE>;
                then-layer = <ADJUST>;
            };
        };
        behaviors: {
            uc_mode_win: uc_mode_win {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&uc UC_SET_WIN_COMPOSE>, <&uc UC_SET_WIN_ALT>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
            };
            uc_mode_mac: uc_mode_mac {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&uc UC_SET_MACOS>, <&uc UC_SET_EMACS>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
            };
            uc_mode_linux: uc_mode_linux {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&uc UC_SET_LINUX>, <&uc UC_SET_LINUX_ALT>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
            };
        };
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// ╭───────┬─────┬─────┬─────┬─────┬─────╮              ╭─────┬─────┬─────┬─────┬─────┬────────╮
// │   `   │  Q  │  W  │  E  │  R  │  T  │              │  Y  │  U  │  I  │  O  │  P  │BKSP/DEL│
// ├───────┼─────┼─────┼─────┼─────┼─────┤              ├─────┼─────┼─────┼─────┼─────┼────────┤
// │CRL/TAB│  A  │  S  │  D  │  F  │  G  │              │  H  │  J  │  K  │  L  │  ;  │   '    │
// ├───────┼─────┼─────┼─────┼─────┼─────┤              ├─────┼─────┼─────┼─────┼─────┼────────┤
// │ SHFT  │  Z  │  X  │  C  │  V  │  B  │              │  N  │  M  │  ,  │  .  │  /  │SHFT/RET│
// ╰───────┴─────┴─────┴─────┼─────┼─────┼─────╮  ╭─────┼─────┼─────┼─────┴─────┴─────┴────────╯
//                           │ GUI │ LWR │ SPC │  │ ENT │ RSE │ ALT │
//                           ╰─────┴─────┴─────╯  ╰─────┴─────┴─────╯
                        bindings = <
//     ╭─────────────────┬──────┬──────┬──────┬─────────┬─────────╮                    ╭──────────┬─────────┬─────────┬────────┬────────┬─────────────╮
        &kp GRAVE         &kp Q  &kp W  &kp E  &kp R     &kp T                          &kp Y      &kp U     &kp I     &kp O    &kp P    &bksp_del_mod
//     ├─────────────────┼──────┼──────┼──────┼─────────┼─────────┤                    ├──────────┼─────────┼─────────┼────────┼────────┼─────────────┤
        &mt LCTRL TAB     &kp A  &kp S  &kp D  &kp F     &kp G                          &kp H      &kp J     &kp K     &kp L    &kp SEMI &kp SQT
//     ├─────────────────┼──────┼──────┼──────┼─────────┼─────────┤                    ├──────────┼─────────┼─────────┼────────┼────────┼─────────────┤
        &td_lshift_capsw  &kp Z  &kp X  &kp C  &kp V     &kp B                          &kp N      &kp M     &kp COMMA &kp DOT  &kp FSLH &mt RSHFT RET
//     ╰─────────────────┴──────┴──────┴──────┼─────────┼─────────┼──────────╮ ╭───────┼──────────┼─────────┼─────────┼────────┴────────┴─────────────╯
                                               &kp LGUI  &mo LOWER  &kp SPACE   &kp RET &mo RAISE  &kp RALT
//                                            ╰─────────┴──────────┴─────────╯ ╰───────┴──────────┴─────────╯

                        >;
                display-name = "ROOT";
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// ╭───────┬─────┬─────┬─────┬─────┬─────╮              ╭─────┬─────┬─────┬─────┬─────┬───────╮
// │  ESC  │  1  │  2  │  3  │  4  │  5  │              │  6  │  7  │  8  │  9  │  0  │  DEL  │
// ├───────┼─────┼─────┼─────┼─────┼─────┤              ├─────┼─────┼─────┼─────┼─────┼───────┤
// │ CTRL  │  !  │  @  │  #  │  $  │  %  │              │  ^  │  &  │  *  │  (  │  )  │       │
// ├───────┼─────┼─────┼─────┼─────┼─────┤              ├─────┼─────┼─────┼─────┼─────┼───────┤
// │ SHFT  │  =  │  -  │  +  │  {  │  }  │              │  [  │  ]  │  ;  │  :  │  \  │       │
// ╰───────┴─────┴─────┴─────┼─────┼─────┼─────╮  ╭─────┼─────┼─────┼─────┼─────┴─────┴───────╯
//                           │ GUI │     │ SPC │  │ ENT │     │ ALT │
//                           ╰─────┴─────┴─────╯  ╰─────┴─────┴─────╯
                        bindings = <
//     ╭─────────────────┬──────────┬──────────┬──────────┬─────────┬─────────╮                    ╭──────────┬─────────┬─────────┬─────────┬─────────┬─────────────╮
        &kp ESC           &kp N1     &kp N2     &kp N3     &kp N4    &kp N5                         &kp N6     &kp N7    &kp N8    &kp N9    &kp N0    &kp DEL
//     ├─────────────────┼──────────┼──────────┼──────────┼─────────┼─────────┤                    ├──────────┼─────────┼─────────┼─────────┼─────────┼─────────────┤
        &mt LCTRL TAB     &kp EXCL   &kp AT     &kp HASH   &kp DLLR  &kp PRCNT                      &kp CARET  &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &none 
//     ├─────────────────┼──────────┼──────────┼──────────┼─────────┼─────────┤                    ├──────────┼─────────┼─────────┼─────────┼─────────┼─────────────┤
        &td_lshift_capsw  &kp EQUAL  &kp MINUS  &kp PLUS   &kp LBRC  &kp RBRC                       &kp LBKT   &kp RBKT  &kp SEMI  &kp COLON &kp BSLH  &mt RSHFT RET
//     ╰─────────────────┴──────────┴──────────┴──────────┼─────────┼─────────┼──────────╮ ╭───────┼──────────┼─────────┼─────────┴─────────┴─────────┴─────────────╯
                                                           &kp LGUI  &trans    &kp SPACE    &kp RET &trans     &kp RALT
//                                                        ╰─────────┴─────────┴──────────╯ ╰───────┴──────────┴─────────╯
                        >;
                display-name = "DESCEND";
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// ╭───────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬───────╮
// │  TAB  │ F1  │ F2  │ F3  │ F4  │ F5  │   │ F6  │ F7  │ F8  │ F9  │ F10 │  F11  │
// ├───────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼───────┤
// │ CTRL  │     │     │     │     │     │   │     │  ←  │  ↑  │  ↓  │  →  │  F12  │
// ├───────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼───────┤
// │ SHFT  │     │     │     │     │     │   │     │     │     │     │     │ SHIFT │
// ╰───────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴───────╯
//                     │ GUI │     │ SPC │   │ ENT │     │ ALT │
//                     ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯
                        bindings = <
//     ╭─────────────────┬───────┬───────┬───────┬──────────┬───────╮                    ╭───────┬───────────────┬───────────────┬───────────────┬───────────────┬──────────────╮
        &kp TAB           &kp F1  &kp F2  &kp F3  &kp F4      &kp F5                      &kp F6  &kp F7          &kp F8          &kp F9          &kp F10         &kp F11
//     ├─────────────────┼───────┼───────┼───────┼──────────┼───────┤                    ├───────┼───────────────┼───────────────┼───────────────┼───────────────┼──────────────┤
        &kp LCTRL         &none   &none   &none   &none       &none                       &none   &nav_left_home  &nav_up_pgup    &nav_down_pgdn  &nav_right_end  &kp F12
//     ├─────────────────┼───────┼───────┼───────┼──────────┼───────┤                    ├───────┼───────────────┼───────────────┼───────────────┼───────────────┼──────────────┤
        &td_lshift_capsw  &none   &none   &none   &none       &none                       &none   &none           &none           &none           &none           &kp RSHFT 
//     ╰─────────────────┴───────┴───────┴───────┼──────────┼───────┼──────────╮ ╭───────┼───────┼───────────────┼───────────────┴───────────────┴───────────────┴──────────────╯
                                                  &kp LGUI   &trans  &kp SPACE    &kp RET &trans  &kp RALT
//                                               ╰──────────┴───────┴──────────╯ ╰───────┴───────┴───────────────╯
                        >;
                display-name = "ASCEND";
                };

                adjust_layer {
// -----------------------------------------------------------------------------------------
// ╭───────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬───────╮
// │ BTCLR │ BT1 │ BT2 │ BT3 │ BT4 │ BT5 │   │     │     │     │     │     │       │
// ├───────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼───────┤
// │OUTTOG │     │     │     │     │     │   │     │     │     │     │     │       │
// ├───────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼───────┤
// │       │     │     │     │     │     │   │     │     │     │     │     │       │
// ╰───────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴───────╯
//                     │     │     │     │   │     │     │     │
//                     ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯
                        bindings = <
//     ╭──────────────┬───────────────┬──────────────┬───────────────┬───────────────┬───────────────╮                  ╭───────┬──────┬──────┬──────┬──────┬──────╮
        &bt BT_CLR     &bt_sel_disc_0  &bt_sel_disc_1 &bt_sel_disc_2  &bt_sel_disc_3  &bt_sel_disc_4                     &none   &none  &none  &none  &none  &none
//     ├──────────────┼───────────────┼──────────────┼───────────────┼───────────────┼───────────────┤                  ├───────┼──────┼──────┼──────┼──────┼──────┤
        &out OUT_TOG   &none           &none          &none           &none           &none                             &none   &none  &none  &none  &none  &none
//     ├──────────────┼───────────────┼──────────────┼───────────────┼───────────────┼───────────────┤                  ├───────┼──────┼──────┼──────┼──────┼──────┤
        &none          &none           &none          &none           &none           &none                             &none   &none  &none  &none  &none  &none
//     ╰──────────────┴───────────────┴──────────────┴───────────────┼───────────────┼───────────────┼───────╮  ╭───────┼───────┼──────┼──────┴──────┴──────┴──────╯
                                                                      &none           &none           &none      &none   &none   &none
//                                                                   ╰───────────────┴───────────────┴───────╯  ╰───────┴───────┴──────╯
                        >;
                        display-name = "SHADOW";
                };
        };
};
