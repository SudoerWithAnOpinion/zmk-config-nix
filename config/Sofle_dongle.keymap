#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <behaviors/unicode.dtsi>
#include <zmk-unicode/keys-full.h> 

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
/ {

   // Activate ADJUST layer by pressing raise and lower
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };
    combos {
        compatible = "zmk,combos";
        combo_greek {
            timeout-ms = <50>;
            key-positions = <17 29>; // T + G
            layers = <BASE>;
            bindings = <&greek>;
        };
        combo_fractions {
            timeout-ms = <50>;
            key-positions = <45 46>; // . + /
            layers = <BASE>;
            bindings = <&fractions>;
        };
    };
    behaviors {
        // Modifies ESCAPE to toggle CAPS_LOCK when double tapped
        td_esc_caps: td_esc_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&kp CAPS>;
        };
        uc_mode_win: uc_mode_win {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_SET_WIN_COMPOSE>, <&uc UC_SET_WIN_ALT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        uc_mode_mac: uc_mode_mac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_SET_MACOS>, <&uc UC_SET_EMACS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        uc_mode_linux: uc_mode_linux {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_SET_LINUX>, <&uc UC_SET_LINUX_ALT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // Special Other-Lang Letters
        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            ignore-keys = <LSHFT RSHFT>;
            
            // German Umlauts
            de_ae { sequence = <COLON A>; bindings = <&uc UC_DE_AE>; }; // ä/Ä
            de_oe { sequence = <COLON O>; bindings = <&uc UC_DE_OE>; }; // ö/Ö
            de_ue { sequence = <COLON U>; bindings = <&uc UC_DE_UE>; }; // ü/Ü

            // Danish/Norwegian/Swedish Letters
            sw_ae { sequence = <A E>; bindings = <&uc UC_DA_AE>; }; // æ/Æ
            sw_oe { sequence = <FSLH O>; bindings = <&uc UC_DA_OE>; }; // ø/Ø
            sw_aa { sequence = <O A>; bindings = <&uc UC_DA_AA>; }; // å/Å

            // French Circmflex
            fr_ca { sequence = <CARET A>; bindings = <&uc UC_FR_A_CIRCUMFLEX>; }; // â/Â
            fr_ce { sequence = <CARET E>; bindings = <&uc UC_FR_E_CIRCUMFLEX>; }; // ê/Ê
            fr_ci { sequence = <CARET I>; bindings = <&uc UC_FR_I_CIRCUMFLEX>; }; // î/Î
            fr_co { sequence = <CARET O>; bindings = <&uc UC_FR_O_CIRCUMFLEX>; }; // ô/Ô
            fr_cu { sequence = <CARET U>; bindings = <&uc UC_FR_U_CIRCUMFLEX>; }; // û/Û
            // French Cedilla
            fr_cs { sequence = <C S>;     bindings = <&uc UC_FR_C_CEDILLA>; }; // ç/Ç
            
            // Currencies, see https://github.com/urob/zmk-unicode/blob/main/include/zmk-unicode/keys/currency.h
            currency_USD { sequence = <U S D>; bindings = <&uc UC_CURR_DOLLAR>; }; // $(Dollar)
            currency_USC { sequence = <U S C>; bindings = <&uc UC_CURR_CENT>; };   // ¢(Cent)
            
            currency_GBP { sequence = <G B P>; bindings = <&uc UC_CURR_POUND>; };  // £(Pound/GBP)
            currency_EUR { sequence = <E U R>; bindings = <&uc UC_CURR_EURO>; };   // €(Euro/EUR)
            currency_PHP { sequence = <P H P>; bindings = <&uc UC_CURR_PESO>; };   // ₱(Peso/PHP)
            currency_JPY { sequence = <J P Y>; bindings = <&uc UC_CURR_YEN>; };    // ¥(Yen/JPY)

            // USE/BLE toggles
            usb { sequence = <U S B>; bindings = <&out OUT_USB>; };
            ble { sequence = <B L E>; bindings = <&out OUT_BLE>; };
        };
        greek: greek {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            ignore-keys = <LSHFT RSHFT>;
            // Greek Letters
            el_alpha   { sequence = <A L P H A>;     bindings = <&uc UC_EL_ALPHA>; };  // α/Α
            el_beta    { sequence = <B E T A>;       bindings = <&uc UC_EL_BETA>; };   // β/Β
            el_gamma   { sequence = <G A M M A>;     bindings = <&uc UC_EL_GAMMA>; };  // γ/Γ
            el_delta   { sequence = <D E L T A>;     bindings = <&uc UC_EL_DELTA>; };  // δ/Δ
            el_epsilon { sequence = <E P S I L O N>; bindings = <&uc UC_EL_EPSILON>; };// ε/Ε
            el_zeta    { sequence = <Z E T A>;       bindings = <&uc UC_EL_ZETA>; };   // ζ/Ζ
            el_eta     { sequence = <E T A>;         bindings = <&uc UC_EL_ETA>; };    // η/Η
            el_theta   { sequence = <T H E T A>;     bindings = <&uc UC_EL_THETA>; };  // θ/Θ
            el_iota    { sequence = <I O T A>;       bindings = <&uc UC_EL_IOTA>; };   // ι/Ι
            el_kappa   { sequence = <K A P P A>;     bindings = <&uc UC_EL_KAPPA>; };  // κ/Κ
            el_lambda  { sequence = <L A M B D A>;   bindings = <&uc UC_EL_LAMBDA>; }; // λ/Λ
            el_mu      { sequence = <M U>;           bindings = <&uc UC_EL_MU>; };     // μ/Μ
            el_nu      { sequence = <N U>;           bindings = <&uc UC_EL_NU>; };     // ν/Ν
            el_xi      { sequence = <X I>;           bindings = <&uc UC_EL_XI>; };     // ξ/Ξ
            el_omikron { sequence = <O M I C R O N>; bindings = <&uc UC_EL_OMIKRON>; };// ο/Ο
            el_pi      { sequence = <P I>;           bindings = <&uc UC_EL_PI>; };     // π/Π
            el_rho     { sequence = <R H O>;         bindings = <&uc UC_EL_RHO>; };    // ρ/Ρ
            el_sigma   { sequence = <S I G M A>;     bindings = <&uc UC_EL_SIGMA>; };  // σ/Σ
            el_tau     { sequence = <T A U>;         bindings = <&uc UC_EL_TAU>; };    // τ/Τ
            el_upsilon { sequence = <U P S I L O N>; bindings = <&uc UC_EL_UPSILON>; };// υ/Υ
            el_phi     { sequence = <P H I>;         bindings = <&uc UC_EL_PHI>; };    // φ/Φ
            el_chi     { sequence = <C H I>;         bindings = <&uc UC_EL_CHI>; };    // χ/Χ
            el_psi     { sequence = <P S I>;         bindings = <&uc UC_EL_PSI>; };    // ψ/Ψ
            el_omega   { sequence = <O M E G A>;     bindings = <&uc UC_EL_OMEGA>; };  // ω/Ω
            // SYMBOL FORMS
            el_epsilon_sym { sequence = <E P S I L O N S>; bindings = <&uc UC_EL_EPSILON_SYM>; }; // ϵ/Ε
            el_theta_sym   { sequence = <T H E T A S>;     bindings = <&uc UC_EL_THETA_SYM>; };   // ϑ/Θ
            el_kappa_sym   { sequence = <K A P P A S>;     bindings = <&uc UC_EL_KAPPA_SYM>; };   // ϰ/Κ
            el_pi_sym      { sequence = <P I S>;           bindings = <&uc UC_EL_PI_SYM>; };      // ϖ/Ω
            el_rho_sym     { sequence = <R H O S>;         bindings = <&uc UC_EL_RHO_SYM>; };     // ϱ/Ρ
            el_phi_sym     { sequence = <P H I S>;         bindings = <&uc UC_EL_PHI_SYM>; };     // φ/Φ
        };
        // TODO: Runic https://github.com/urob/zmk-unicode/blob/main/include/zmk-unicode/keys/blocks/runic.h
        // runic: runic {};
        fractions: fractions {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            ignore-keys = <LSHFT RSHFT>;
            frac_1_3  { sequence = <N1 FSLH N3>;    bindings = <&uc UC_VULGAR_FRACTION_ONE_THIRD>; };    // ⅓
            frac_2_3  { sequence = <N2 FSLH N3>;    bindings = <&uc UC_VULGAR_FRACTION_TWO_THIRDS>; };   // ⅔
            frac_1_5  { sequence = <N1 FSLH N5>;    bindings = <&uc UC_VULGAR_FRACTION_ONE_FIFTH>; };    // ⅕
            frac_2_5  { sequence = <N2 FSLH N5>;    bindings = <&uc UC_VULGAR_FRACTION_TWO_FIFTHS>; };   // ⅖
            frac_3_5  { sequence = <N3 FSLH N5>;    bindings = <&uc UC_VULGAR_FRACTION_THREE_FIFTHS>; }; // ⅗
            frac_4_5  { sequence = <N4 FSLH N5>;    bindings = <&uc UC_VULGAR_FRACTION_FOUR_FIFTHS>; };  // ⅘
            frac_1_6  { sequence = <N1 FSLH N6>;    bindings = <&uc UC_VULGAR_FRACTION_ONE_SIXTH>; };    // ⅙
            frac_5_6  { sequence = <N5 FSLH N6>;    bindings = <&uc UC_VULGAR_FRACTION_FIVE_SIXTHS>; };  // ⅚
            frac_1_7  { sequence = <N1 FSLH N7>;    bindings = <&uc UC_VULGAR_FRACTION_ONE_SEVENTH>; };  // ⅐
            frac_1_8  { sequence = <N1 FSLH N8>;    bindings = <&uc UC_VULGAR_FRACTION_ONE_EIGHTH>; };   // ⅛
            frac_3_8  { sequence = <N3 FSLH N8>;    bindings = <&uc UC_VULGAR_FRACTION_THREE_EIGHTHS>; };// ⅜
            frac_5_8  { sequence = <N5 FSLH N8>;    bindings = <&uc UC_VULGAR_FRACTION_FIVE_EIGHTHS>; }; // ⅝
            frac_7_8  { sequence = <N7 FSLH N8>;    bindings = <&uc UC_VULGAR_FRACTION_SEVEN_EIGHTHS>; };// ⅞
            frac_1_9  { sequence = <N1 FSLH N9>;    bindings = <&uc UC_VULGAR_FRACTION_ONE_NINTH>; };    // ⅑
            frac_1_10 { sequence = <N1 FSLH N1 N0>; bindings = <&uc UC_VULGAR_FRACTION_ONE_TENTH>; };    // ⅒
        };
        // TODO: Mathematical Symbols, see: 
        //  https://github.com/urob/zmk-unicode/blob/main/include/zmk-unicode/keys/blocks/miscellaneous_mathematical_symbols_a.h
        //  https://github.com/urob/zmk-unicode/blob/main/include/zmk-unicode/keys/blocks/mathematical_operators.h
        //  https://github.com/urob/zmk-unicode/blob/main/include/zmk-unicode/keys/blocks/general_punctuation.h
        
        // Letterlikes, see: https://github.com/urob/zmk-unicode/blob/main/include/zmk-unicode/keys/blocks/letterlike_symbols.h
        // ACTIVATE: <NONE>
        letterlike: letterlike {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            ignore-keys = <LSHFT RSHFT>;
            ll_deg_c { sequence = <O C>;    bindings = <&uc UC_DEGREE_CELSIUS>; };               // ℃
            ll_deg_f { sequence = <O F>;    bindings = <&uc UC_DEGREE_FAHRENHEIT>; };            // ℉
            ll_accof { sequence = <A FSLH O>;    bindings = <&uc UC_ACCOUNT_OF>; };              // ℀
            ll_adsbj { sequence = <A FSLH S>;    bindings = <&uc UC_ADDRESSED_TO_THE_SUBJECT>; };// ℁
            ll_caref  { sequence = <C FSLH O>;    bindings = <&uc UC_CARE_OF>; };                // ℅
            ll_cdun  { sequence = <C FSLH U>;    bindings = <&uc UC_CADA_UNA>; };                // ℆
            ll_ohm   { sequence = <O H M>;    bindings = <&uc UC_OHM_SIGN>; };                   // Ω
        };
        // Control Pictures, see: https://github.com/urob/zmk-unicode/blob/main/include/zmk-unicode/keys/blocks/control_pictures.h
        // ACTIVATE: <NONE>
        control_pic: control_pic {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            ignore-keys = <LSHFT RSHFT>;
            cp_null { sequence = <N U L L>;    bindings = <&uc UC_SYMBOL_FOR_NULL>; }; // ␀
            cp_ack  { sequence = <A C K>;  bindings = <&uc UC_SYMBOL_FOR_ACKNOWLEDGE>; };          // ␆
            cp_nak  { sequence = <N A K>;  bindings = <&uc UC_SYMBOL_FOR_NEGATIVE_ACKNOWLEDGE>; }; // ␕
            cp_syn  { sequence = <S Y N>;  bindings = <&uc UC_SYMBOL_FOR_SYNCHRONOUS_IDLE>; };     // ␖
            cp_cr   { sequence = <C R>;    bindings = <&uc UC_SYMBOL_FOR_CARRIAGE_RETURN>; };      // ␍
            cp_lf   { sequence = <L F>;    bindings = <&uc UC_SYMBOL_FOR_LINE_FEED>; };            // ␊
            cp_esc  { sequence = <E S C>;  bindings = <&uc UC_SYMBOL_FOR_ESCAPE>; };               // ␛
        };
        // Arrows: https://github.com/urob/zmk-unicode/blob/main/include/zmk-unicode/keys/blocks/arrows.h
        arrows: arrows {
             compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            ignore-keys = <LSHFT RSHFT>;
            // I J K L arrows
            arr_l { sequence = <J PERIOD>;    bindings = <&uc UC_LEFTWARDS_ARROW>; }; // ←
            arr_u { sequence = <I PERIOD>;    bindings = <&uc UC_UPWARDS_ARROW>; }; // ↑
            arr_r { sequence = <L PERIOD>;    bindings = <&uc UC_RIGHTWARDS_ARROW>; }; // →
            arr_d { sequence = <K PERIOD>;    bindings = <&uc UC_DOWNWARDS_ARROW>; }; // ↓
            // Hook arrows
            arr_lh { sequence = <J H>;     bindings = <&uc UC_LEFTWARDS_ARROW_WITH_HOOK>; }; // ↩
            arr_rh { sequence = <L H>;     bindings = <&uc UC_RIGHTWARDS_ARROW_WITH_HOOK>; }; // ↪

            // Directional harpoons: <direction> H <barb-direction>
            arr_lhu { sequence = <J H U>;  bindings = <&uc UC_LEFTWARDS_HARPOON_WITH_BARB_UPWARDS>; }; // ↼
            arr_lhd { sequence = <J H D>;  bindings = <&uc UC_LEFTWARDS_HARPOON_WITH_BARB_DOWNWARDS>; }; // ↽
            arr_uhr { sequence = <I H R>;  bindings = <&uc UC_UPWARDS_HARPOON_WITH_BARB_RIGHTWARDS>; }; // ↾
            arr_uhl { sequence = <I H L>;  bindings = <&uc UC_UPWARDS_HARPOON_WITH_BARB_LEFTWARDS>; }; // ↿
            arr_rhu { sequence = <L H U>;  bindings = <&uc UC_RIGHTWARDS_HARPOON_WITH_BARB_UPWARDS>; }; // ⇀
            arr_rhd { sequence = <L H D>;  bindings = <&uc UC_RIGHTWARDS_HARPOON_WITH_BARB_DOWNWARDS>; }; // ⇁
            arr_dhr { sequence = <K H R>;  bindings = <&uc UC_DOWNWARDS_HARPOON_WITH_BARB_RIGHTWARDS>; }; // ⇂
            arr_dhl { sequence = <K H L>;  bindings = <&uc UC_DOWNWARDS_HARPOON_WITH_BARB_LEFTWARDS>; }; // ⇃

            // Compound arrows
            arr_rol { sequence = <R O L>;  bindings = <&uc UC_RIGHTWARDS_ARROW_OVER_LEFTWARDS_ARROW>; }; // ⇄
            arr_uod { sequence = <U O D>;  bindings = <&uc UC_UPWARDS_ARROW_LEFTWARDS_OF_DOWNWARDS_ARROW>; }; // ⇅
            arr_lor { sequence = <L O R>;  bindings = <&uc UC_LEFTWARDS_ARROW_OVER_RIGHTWARDS_ARROW>; }; // ⇆

            // Paired arrows
            arr_pl { sequence = <P L>;     bindings = <&uc UC_LEFTWARDS_PAIRED_ARROWS>; }; // ⇇
            arr_pu { sequence = <P U>;     bindings = <&uc UC_UPWARDS_PAIRED_ARROWS>; }; // ⇈
            arr_pr { sequence = <P R>;     bindings = <&uc UC_RIGHTWARDS_PAIRED_ARROWS>; }; // ⇉
            arr_pd { sequence = <P D>;     bindings = <&uc UC_DOWNWARDS_PAIRED_ARROWS>; }; // ⇊

            // Harpoon-over-harpoon
            arr_lho { sequence = <L H O>;  bindings = <&uc UC_LEFTWARDS_HARPOON_OVER_RIGHTWARDS_HARPOON>; }; // ⇋
            arr_rho { sequence = <R H O>;  bindings = <&uc UC_RIGHTWARDS_HARPOON_OVER_LEFTWARDS_HARPOON>; }; // ⇌
        };
        // TODO: Alchemical Symbols, see: https://github.com/urob/zmk-unicode/blob/main/include/zmk-unicode/keys/blocks/alchemical_symbols.h
    };

    keymap {
        compatible = "zmk,keymap";   

        default_layer {
            display-name = "base";
// ------------------------------------------------------------------------------------------------------------
// ╭───────┬─────┬─────┬─────┬─────┬─────╮                 ╭─────┬─────┬─────┬─────┬─────┬───────╮
// │   `   │  1  │  2  │  3  │  4  │  5  │                 │  6  │  7  │  8  │  9  │  0  │  DEL  │
// ├───────┼─────┼─────┼─────┼─────┼─────┤                 ├─────┼─────┼─────┼─────┼─────┼───────┤
// │  ESC  │  Q  │  W  │  E  │  R  │  T  │                 │  Y  │  U  │  I  │  O  │  P  │ BKSPC │
// ├───────┼─────┼─────┼─────┼─────┼─────┤                 ├─────┼─────┼─────┼─────┼─────┼───────┤
// │  TAB  │  A  │  S  │  D  │  F  │  G  │                 │  H  │  J  │  K  │  L  │  ;  │   '   │
// ├───────┼─────┼─────┼─────┼─────┼─────┼──────╮  ╭───────┼─────┼─────┼─────┼─────┼─────┼───────┤
// │ SHIFT │  Z  │  X  │  C  │  V  │  B  │ MUTE │  │RGB_TOG│ N   │  M  │  ,  │  .  │  /  │ SHIFT │
// ╰───────┴─────┼─────┼─────┼─────┼─────┼──────┤  ├───────┼─────┼─────┼─────┼─────┼─────┴───────╯
//               │ GUI │ ALT │ CTRL│LOWER│SPACE │  │ ENTER │RAISE│CTRL │ ALT │ GUI │
//               ╰─────┴─────┴─────┴─────┴──────╯  ╰───────┴─────┴─────┴─────┴─────╯
            bindings = <
&kp GRAVE    &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                                     &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp DEL
&td_esc_caps &kp Q  &kp W    &kp E    &kp R     &kp T                                      &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp TAB      &kp A  &kp S    &kp D    &kp F     &kp G                                      &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT    &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE &rgb_ug RGB_TOG      &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &mt LSHIFT RET
                    &kp LGUI &kp LALT &kp LCTRL &mo LOWER  &kp SPACE              &kp RET  &mo RAISE  &kp RCTRL &kp RALT  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";
// TODO: Some binds are waiting for shifted keycode support.
// ------------------------------------------------------------------------------------------------------------
// ╭───────┬─────┬─────┬─────┬─────┬─────╮                 ╭─────┬─────┬─────┬─────┬─────┬───────╮
// │LEADER │ F1  │ F2  │ F3  │ F4  │ F5  │                 │ F6  │ F7  │ F8  │ F9  │ F10 │  F11  │
// ├───────┼─────┼─────┼─────┼─────┼─────┤                 ├─────┼─────┼─────┼─────┼─────┼───────┤
// │       │  1  │  2  │  3  │  4  │  5  │                 │  6  │  7  │  8  │  9  │  0  │  F12  │
// ├───────┼─────┼─────┼─────┼─────┼─────┤                 ├─────┼─────┼─────┼─────┼─────┼───────┤
// │       │  !  │  @  │  #  │  $  │  %  │                 │  ^  │  &  │  *  │  (  │  )  │   |   │
// ├───────┼─────┼─────┼─────┼─────┼─────┼──────╮  ╭───────┼─────┼─────┼─────┼─────┼─────┼───────┤
// │       │  =  │  -  │  +  │  {  │  }  │      │  │       │  [  │  ]  │  ;  │  :  │  \  │       │
// ╰───────┴─────┴─────┼─────┼─────┼─────┼──────┤  ├───────┼─────┼─────┼─────┼─────┼─────┴───────╯
//                     │     │     │     │      │  │       │     │     │     │     │
//                     ╰─────┴─────┴─────┴──────╯  ╰───────┴─────┴─────┴─────┴─────╯
            bindings = <
&leader    &kp F1    &kp F2    &kp F3      &kp F4    &kp F5                       &kp F6    &kp F7   &kp F8    &kp F9    &kp F10   &kp F11
&none     &kp N1    &kp N2    &kp N3      &kp N4    &kp N5                       &kp N6    &kp N7   &kp N8    &kp N9    &kp N0    &kp F12
&ext_power EP_TOG   &kp EXCL  &kp AT      &kp HASH  &kp DLLR  &kp PRCNT          &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR  &kp PIPE
&trans    &kp EQUAL &kp MINUS &kp PLUS    &kp LBRC  &kp RBRC  &trans     &trans  &kp LBKT  &kp RBKT &kp SEMI  &kp COLON &kp BSLH  &trans
                    &trans    &trans      &trans    &trans    &trans     &trans  &trans    &trans   &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "raise";
// ------------------------------------------------------------------------------------------------------------
// ╭───────┬─────┬─────┬─────┬─────┬─────╮                 ╭─────┬────────┬─────┬────────┬───────┬────────╮
// │ BTCLR │ BT1 │ BT2 │ BT3 │ BT4 │ BT5 │                 │     │        │     │        │ PSBRK │ INSERT │
// ├───────┼─────┼─────┼─────┼─────┼─────┤                 ├─────┼────────┼─────┼────────┼───────┼────────┤
// │       │ INS │PSCR │ GUI │     │     │                 │PGUP │ PVWORD │  ↑  │ NXWORD │SYSREQ │ BKSPC  │
// ├───────┼─────┼─────┼─────┼─────┼─────┤                 ├─────┼────────┼─────┼────────┼───────┼────────┤
// │       │ ALT │CTRL │SHIFT│     │CAPS │                 │PGDN │   ←    │  ↓  │   →    │       │        │
// ├───────┼─────┼─────┼─────┼─────┼─────┼──────╮  ╭───────┼─────┼────────┼─────┼────────┼───────┼────────┤
// │       │UNDO │ CUT │COPY │PASTE│     │      │  │       │     │ HOME   │     │  END   │       │        │
// ╰───────┴─────┴─────┼─────┼─────┼─────┼──────┤  ├───────┼─────┼────────┼─────┼────────┴───────┴────────╯
//                     │     │     │     │      │  │       │     │        │     │        │
//                     ╰─────┴─────┴─────┴──────╯  ╰───────┴─────┴────────┴─────┴────────╯
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &trans    &trans    &trans   &trans    &kp PAUSE_BREAK  &kp INSERT
&trans     &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                        &kp PG_UP &kp LC(LEFT)    &kp UP   &kp LC(RIGHT)        &kp SYSREQ  &kp BSPC
&trans     &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                      &kp PG_DN &kp LEFT  &kp DOWN &kp RIGHT &none            &none
&trans     &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans        &trans  &trans  &trans    &kp HOME  &trans   &kp END   &trans           &trans
                        &trans       &trans       &trans       &trans        &trans  &trans  &trans    &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "adjust";
// ----------------------------------------------------------------------------------------------------------------------------
// ╭────────┬─────────┬─────────┬─────────┬─────────┬─────────╮                  ╭─────┬─────┬─────┬─────┬────────┬────────╮
// │ BTCLR  │   BT1   │   BT2   │   BT3   │   BT4   │   BT5   │                  │     │     │     │     │ UC WIN │OUT BLE │
// ├────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                  ├─────┼─────┼─────┼─────┼────────┼────────┤
// │ EXTPWR │ RGB_HUD │ RGB_HUI │ RGB_SAD │ RGB_SAI │ RGB_EFF │                  │     │     │     │     │ UC MAC │OUT USB │
// ├────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                  ├─────┼─────┼─────┼─────┼────────┼────────┤
// │        │ RGB_BRD │ RGB_BRI │         │         │         │                  │     │     │     │     │ UC LIN │OUT TOG │
// ├────────┼─────────┼─────────┼─────────┼─────────┼─────────┼───────╮  ╭───────┼─────┼─────┼─────┼─────┼────────┼────────┤
// │        │         │         │         │         │         │RGB_TOG│  │       │     │     │     │     │        │        │
// ╰────────┴─────────┴─────────┼─────────┼─────────┼─────────┼───────┤  ├───────┼─────┼─────┼─────┼─────┴────────┴────────╯
//                              │         │         │         │       │  │       │     │     │     │     │
//                              ╰─────────┴─────────┴─────────┴───────╯  ╰───────┴─────┴─────┴─────┴─────╯
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &none &none &none &none &uc_mode_win &out OUT_BLE
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &none &none &none &none &uc_mode_mac &out OUT_USB 
&none             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &none                                   &none &none &none &none &uc_mode_linux  &out OUT_TOG
&none             &none           &none           &none           &none           &none            &none           &none  &none &none &none &none &none &none
                                  &none           &none           &none           &none            &none           &none  &none &none &none &none
            >;
        };
        extra1 {
            status = "reserved";
        };
        extra2 {
            status = "reserved";
        };
        extra3 {
            status = "reserved";
        };
        extra4 {
            status = "reserved";
        };

    };
};